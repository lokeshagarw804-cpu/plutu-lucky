  },
  {
    "id": "P03",
    "name": "nested_scope",
    "source": "base = 100; tax = 15; total = base + tax; if total > 50: discount = total * 0.1; final = total - discount",
    "expected_result": {"base": 100, "tax": 15, "total": 115, "discount": 11.5, "final": 103.5}
  },
  {
    "id": "P04",
    "name": "common_subexpr",
    "source": "a = 3 + 5; b = 3 + 5; c = a * b; d = 3 + 5",
    "expected_result": {"a": 8, "b": 8, "c": 64, "d": 8}
  },
  {
    "id": "P05",
    "name": "precedence_chain",
    "source": "r = 1 + 2 * 3 + 4 * 5; s = r / 2; t = s + 0.5",
    "expected_result": {"r": 27, "s": 13.5, "t": 14.0}
  },
  {
    "id": "P06",
    "name": "dead_code_safe",
    "source": "width = 10; height = 20; area = width * height; unused = 999; perimeter = 2 * width + 2 * height",
    "expected_result": {"width": 10, "height": 20, "area": 200, "perimeter": 60}
